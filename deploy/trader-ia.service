[Unit]
Description=Trader IA 24/7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajustá estas dos rutas a donde clonaste el repo y a tu usuario del VPS
User=trader
WorkingDirectory=/home/trader/trader_ia_247
ExecStart=/home/trader/trader_ia_247/venv/bin/python main.py
Restart=on-failure
RestartSec=15
StandardOutput=append:/var/log/trader-ia-247.log
StandardError=append:/var/log/trader-ia-247.log

[Install]
WantedBy=multi-user.target
