# --- Exchange ---
# Ver lista completa de exchanges soportados: python -c "import ccxt; print(ccxt.exchanges)"
EXCHANGE_ID=binance
API_KEY=tu_api_key_aqui
API_SECRET=tu_api_secret_aqui
API_PASSWORD=

# --- Mercado ---
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
CANDLE_LIMIT=100

# --- Riesgo (todos en %, ajustalos a tu tolerancia real) ---
RISK_PCT_PER_TRADE=1.0
MAX_EXPOSURE_PCT=20.0
MAX_DRAWDOWN_PCT=8.0
MAX_DRAWDOWN_KILL_PCT=15.0
MAX_VOLATILITY_PCT=4.0
ATR_STOP_MULT=1.5
MIN_RR=1.8

# --- Ejecución ---
# LIVE_TRADING=false  -> modo papel, no manda ninguna orden real (recomendado para probar primero)
# LIVE_TRADING=true   -> coloca órdenes reales con dinero real
LIVE_TRADING=false

# AUTO_EXECUTE=false  -> te pide confirmación en consola antes de cada orden real
# AUTO_EXECUTE=true   -> ejecuta automáticamente sin preguntar (sin humano en el loop)
AUTO_EXECUTE=false

ORDER_TYPE=market
LOOP_INTERVAL_SECONDS=300
DB_PATH=trader_ia_247.db

# --- Telegram (opcional, recomendado si LIVE_TRADING=true) ---
# 1. Hablá con @BotFather en Telegram -> /newbot -> copiá el token acá.
# 2. Hablá con @userinfobot para conseguir tu chat_id (o el del grupo/canal que uses).
# 3. Mandale un mensaje a tu bot al menos una vez antes de arrancar (si no, getUpdates no lo ve).
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_TIMEOUT_SECONDS=900

# --- Solo para el modo serverless (Vercel + Supabase) ---
# Estas NO van en tu .env local del VPS — se configuran como variables de
# entorno del proyecto en el dashboard de Vercel (Settings → Environment Variables).
# SUPABASE_URL=https://tuproyecto.supabase.co
# SUPABASE_KEY=tu_service_role_key   (no la anon key — esto corre server-side)
# CRON_SECRET=                        (Vercel lo genera solo al agregar el cron)
# TELEGRAM_WEBHOOK_SECRET=un_secreto_random_que_vos_elijas
